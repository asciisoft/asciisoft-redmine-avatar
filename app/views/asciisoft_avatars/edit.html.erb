<% content_for :header_tags do %>
  <%= javascript_include_tag('asciisoft_avatar', plugin: 'asciisoft_redmine_avatar', defer: true) %>
<% end %>
<% html_title(l(:asciisoft_avatar_title)) %>

<div class="contextual">
  <%= link_to l(:label_my_account), my_account_path %>
</div>

<h2><%= l(:asciisoft_avatar_title) %></h2>

<div class="box asciisoft-avatar-page">
  <div class="asciisoft-avatar-current">
    <%= avatar(@user, size: 128) %>
    <div>
      <strong><%= @user.name %></strong>
      <p class="info"><%= @has_avatar ? l(:asciisoft_avatar_have) : l(:asciisoft_avatar_none) %></p>
      <% if @has_avatar %>
        <%= button_to l(:button_delete), asciisoft_my_avatar_path, method: :delete,
              data: { confirm: l(:text_are_you_sure) }, class: 'asciisoft-avatar-delete' %>
      <% end %>
    </div>
  </div>

  <%= form_tag(asciisoft_my_avatar_path, multipart: true, id: 'asciisoft-avatar-form',
               data: { msg_type: l(:asciisoft_avatar_invalid), msg_pick: l(:asciisoft_avatar_pick_first) }) do %>
    <p>
      <label for="asciisoft-avatar-file"><%= l(:asciisoft_avatar_choose) %></label>
      <%= file_field_tag 'avatar', id: 'asciisoft-avatar-file', accept: 'image/png,image/jpeg,image/gif,image/webp' %>
      <em class="info"><%= l(:asciisoft_avatar_hint) %></em>
    </p>
    <div id="asciisoft-avatar-cropper" hidden>
      <canvas id="asciisoft-avatar-canvas" width="256" height="256" aria-label="<%= l(:asciisoft_avatar_crop) %>"></canvas>
      <p class="asciisoft-avatar-zoom-row">
        <label for="asciisoft-avatar-zoom"><%= l(:asciisoft_avatar_zoom) %></label>
        <input type="range" id="asciisoft-avatar-zoom" min="1" max="4" step="0.01" value="1">
      </p>
      <p class="info"><%= l(:asciisoft_avatar_drag) %></p>
    </div>
    <p><%= submit_tag l(:button_save), id: 'asciisoft-avatar-save' %></p>
  <% end %>
</div>

<% content_for :sidebar do %>
  <%= render partial: 'my/sidebar' %>
<% end %>
